# 复制为 .env 后按需修改；docker compose 会自动读取 .env

# 宿主机发布端口（应用服务），浏览器/接口通过 宿主IP:该端口 访问
CC_PUBLISH_PORT=3060

# PostgreSQL 数据库密码（仅 compose 内部网络使用，不发布端口）
DB_PASSWORD=waste123

# JWT 签名密钥（生产环境务必替换为随机长字符串）
JWT_SECRET=change-me-please-change-me-please-0123456789abcdef

# compose 项目名（平台验证环境已注入，本地可自定义）
# COMPOSE_PROJECT_NAME=waste-station
